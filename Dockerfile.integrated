# syntax=docker/dockerfile:1.7
# Supply the exact competition image reference; never substitute the dev image.
ARG OFFICIAL_BASE_IMAGE
FROM ${OFFICIAL_BASE_IMAGE}
ARG TEAM_NAME
RUN test -n "${TEAM_NAME}" && test "${TEAM_NAME}" != "队名"
ARG PLATFORM_PYTHON=/opt/conda/envs/conda_env/bin/python
ENV PYTHON_BIN=/opt/migu-inference/bin/python \
    INFERENCE_BACKEND=integrated \
    HF_HUB_OFFLINE=1 \
    TRANSFORMERS_OFFLINE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1
RUN ${PLATFORM_PYTHON} -m venv --system-site-packages /opt/migu-inference && \
    /opt/migu-inference/bin/python -m pip install --no-deps peft==0.21.2 accelerate==1.15.0
WORKDIR /root/participant
COPY src/ src/
COPY scripts/ scripts/
COPY configs/ configs/
COPY start.sh start.sh
COPY run_inference.py run_inference.py
# Named context contains the selected classifier, response base and adapter,
# plus the fixed v1 profile checkpoint for independent-profile preflight.
COPY --from=model_assets /emotion_longtail075_b1_20261016/ weights/emotion_longtail075_b1_20261016/
COPY --from=model_assets /hf/Qwen2.5-1.5B-Instruct/ weights/hf/Qwen2.5-1.5B-Instruct/
COPY --from=model_assets /response_sft_d4_2ep/ weights/response_sft_d4_2ep/
COPY --from=model_assets /profile_encoder_v1_b1_20261026/ weights/profile_encoder_v1_b1_20261026/
COPY --from=expert_materials / /root/AI技术赛道-数字人综合情感对话模型-${TEAM_NAME}/
RUN chmod +x start.sh && ${PYTHON_BIN} scripts/cloud_preflight.py \
    --config configs/integrated_profile_v1_off.json --files-only --verify-hashes
ENTRYPOINT ["/root/participant/start.sh"]
